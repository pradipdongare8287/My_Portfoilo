<%-include('header.ejs')%>
<div style="
    width: 100%;
    max-width: 650px;
    margin: 50px auto;
    padding: 35px;
    background: #ffffff;
    border-radius: 18px;
    box-shadow: 0 10px 35px rgba(0,0,0,0.10);
    box-sizing: border-box;
">

    <!-- Form Heading -->
    <div style="
        text-align: center;
        margin-bottom: 30px;
    ">
        <h2 style="
            margin: 0 0 8px;
            font-size: 28px;
            color: #111827;
            font-weight: 700;
        ">
            Add Certificate
        </h2>

        <p style="
            margin: 0;
            color: #6b7280;
            font-size: 14px;
        ">
            Add your certificate to your portfolio
        </p>
    </div>


    <form 
        action="/admin/uploade_certificate" 
        method="POST" 
        enctype="multipart/form-data"
    >

        <!-- Certificate Image -->

        <div style="margin-bottom: 22px;">

            <label style="
                display: block;
                margin-bottom: 8px;
                font-size: 15px;
                font-weight: 600;
                color: #374151;
            ">
                Certificate Image
            </label>

            <div style="
                border: 2px dashed #cbd5e1;
                border-radius: 12px;
                padding: 25px;
                text-align: center;
                background: #f8fafc;
                transition: 0.3s;
            ">

                <div style="
                    font-size: 40px;
                    margin-bottom: 10px;
                ">
                    📜
                </div>

                <p style="
                    margin: 0 0 12px;
                    color: #64748b;
                    font-size: 14px;
                ">
                    Upload your certificate image
                </p>

                <input
                    type="file"
                    name="certificate_image"
                    accept="image/*"
                    required
                    style="
                        width: 100%;
                        padding: 10px;
                        border: 1px solid #d1d5db;
                        border-radius: 8px;
                        background: #ffffff;
                        box-sizing: border-box;
                        cursor: pointer;
                    "
                >

            </div>

        </div>


        <!-- Certificate Name -->

        <div style="margin-bottom: 22px;">

            <label style="
                display: block;
                margin-bottom: 8px;
                font-size: 15px;
                font-weight: 600;
                color: #374151;
            ">
                Certificate Name
            </label>

            <input
                type="text"
                name="certificate_name"
                placeholder="Enter certificate name"
                required
                style="
                    width: 100%;
                    height: 48px;
                    padding: 0 15px;
                    border: 1px solid #d1d5db;
                    border-radius: 9px;
                    outline: none;
                    font-size: 15px;
                    color: #111827;
                    box-sizing: border-box;
                    transition: 0.3s;
                "
            >

        </div>


        <!-- Institute Name -->

        <div style="margin-bottom: 28px;">

            <label style="
                display: block;
                margin-bottom: 8px;
                font-size: 15px;
                font-weight: 600;
                color: #374151;
            ">
                Institute Name
            </label>

            <input
                type="text"
                name="institute_name"
                placeholder="Enter institute name"
                required
                style="
                    width: 100%;
                    height: 48px;
                    padding: 0 15px;
                    border: 1px solid #d1d5db;
                    border-radius: 9px;
                    outline: none;
                    font-size: 15px;
                    color: #111827;
                    box-sizing: border-box;
                    transition: 0.3s;
                "
            >

        </div>


        <!-- Submit Button -->

        <button
            type="submit"
            style="
                width: 100%;
                height: 50px;
                border: none;
                border-radius: 9px;
                background: #2563eb;
                color: #ffffff;
                font-size: 16px;
                font-weight: 600;
                cursor: pointer;
                transition: 0.3s;
            "
        >
            + Add Certificate
        </button>

    </form>

</div>
<%-include('footer.ejs')%>
