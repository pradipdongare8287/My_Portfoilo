<%-include('header.ejs'); %>
    
            <!-- ===== DASHBOARD CONTENT ===== -->
           
<div class="page-content">
    <div class="container-fluid">

        <!-- Page Header -->
        <div class="page-header d-flex justify-content-between align-items-center"
             style="padding: 20px 0; margin-bottom: 25px; border-bottom: 2px solid #e9ecef;">

            <div>
                <h1 class="h3 mb-1" style="font-weight: 700; color: #2c3e50;">
                    Manage Service
                </h1>
                <p class="text-muted small mb-0">
                    Welcome back,<%=username%> Here's your overview
                </p>
            </div>

            <div></div>
        </div>

        <!-- Service Table -->
        <div style="background: #ffffff; padding: 20px; border-radius: 15px;
                    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
                    overflow-x: auto;">

            <table border="0" width="100%"
                   style="border-collapse: separate; border-spacing: 0;
                          min-width: 700px; overflow: hidden;
                          border-radius: 10px;">

                <tr style="background: linear-gradient(135deg, #4776E6, #6C5CE7);
                           color: white; text-align: center;
                           font-size: 16px;">

                    <th style="padding: 16px 12px;">Sr</th>
                    <th style="padding: 16px 12px;">Service name</th>
                    <th style="padding: 16px 12px;">Service icon</th>
                    <th style="padding: 16px 12px;">Service discription</th>
                    <th style="padding: 16px 12px;">Action</th>
                </tr>

                <% for(var i=0;i<service.length;i++){ %>

                <tr style="background-color: <%= i % 2 === 0 ? '#f8f9ff' : '#ffffff' %>;
                           font-size: 15px; text-align: center;
                           color: #344054;">

                    <td style="padding: 15px 12px; border-bottom: 1px solid #e9ecef;">
                        <%=i+1%>
                    </td>

                    <td style="padding: 15px 12px; border-bottom: 1px solid #e9ecef;
                               font-weight: 600; color: #2c3e50;">
                        <%=service[i].Service_name%>
                    </td>

                    <td style="padding: 15px 12px; border-bottom: 1px solid #e9ecef;">
                        <%=service[i].Service_icon%>
                    </td>

                    <td style="padding: 15px 12px; border-bottom: 1px solid #e9ecef;
                               max-width: 300px; overflow-wrap: anywhere;">
                        <%=service[i].Service_discription%>
                    </td>

                    <td style="padding: 15px 12px; border-bottom: 1px solid #e9ecef;
                               white-space: nowrap;">

                        <a href="/admin/del_ser/<%=service[i].sr_id%>"
                           style="text-decoration: none; margin-right: 6px;">
                            <button class="btn btn-danger"
                                    style="border-radius: 8px; padding: 8px 12px;
                                           box-shadow: 0 3px 7px rgba(220,53,69,0.2);">
                                <i class="fa fa-trash"></i>
                            </button>
                        </a>

                        <a>
                            <button class="btn btn-success"
                                    style="border-radius: 8px; padding: 8px 12px;
                                           box-shadow: 0 3px 7px rgba(25,135,84,0.2);">
                                <i class="fa fa-pencil"></i>
                            </button>
                        </a>

                    </td>
                </tr>

                <% } %>

            </table>
        </div>

    </div>
</div>


 <%-include('footer.ejs'); %>

