<%-include('header.ejs'); %>

            <!-- ===== DASHBOARD CONTENT ===== -->
            <div class="page-content">
            
<div class="container-fluid" style="padding:30px;background:#f4f6fb;min-height:100vh;">

    <!-- Page Header -->
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;margin-bottom:30px;">
        <div>
            <h1 style="font-size:30px;font-weight:800;color:#252b48;margin:0 0 8px 0;">
                Add Services
            </h1>
            <p style="font-size:14px;color:#858ba3;margin:0;">
                Welcome back, <%=username%> — Manage your portfolio services
            </p>
        </div>

        <div style="background:#e9e8ff;color:#6259e8;padding:11px 18px;border-radius:30px;font-size:12px;font-weight:800;letter-spacing:1px;">
            <i class="fa fa-cogs" style="margin-right:7px;"></i>
            SERVICE SETTINGS
        </div>
    </div>

    <!-- Main Card -->
    <div style="max-width:900px;margin:0 auto;background:white;border-radius:18px;overflow:hidden;box-shadow:0 8px 35px rgba(35,45,90,0.08);">

        <!-- Card Header -->
        <div style="padding:27px 30px;background:linear-gradient(135deg,#6d67ff,#8b83ff);color:white;">
            <h2 style="font-size:23px;font-weight:800;margin:0 0 8px 0;">
                <i class="fa fa-layer-group" style="margin-right:10px;"></i>
                Create New Service
            </h2>
            <p style="font-size:13px;color:#eeedff;margin:0;">
                Add your service details and make your portfolio stand out
            </p>
        </div>

        <!-- Form Body -->
        <form action="/admin/add_service" method="post" style="padding:30px;">

            <!-- Service Name -->
            <div style="margin-bottom:25px;">
                <label style="display:block;font-size:14px;font-weight:700;color:#343b59;margin-bottom:10px;">
                    <i class="fa fa-briefcase" style="color:#6d67ff;margin-right:8px;"></i>
                    Service Name
                </label>

                <input
                    type="text"
                    name="Service_name"
                    placeholder="e.g. Web Development"
                    style="box-sizing:border-box;width:100%;height:50px;padding:0 16px;border:1px solid #dfe3ef;border-radius:10px;background:#fafbff;font-size:14px;color:#303650;outline:none;"
                >

                <p style="font-size:12px;color:#9298ac;margin:8px 0 0 0;">
                    Enter the name of the service you provide.
                </p>
            </div>

            <!-- Service Icon -->
            <div style="margin-bottom:25px;">
                <label style="display:block;font-size:14px;font-weight:700;color:#343b59;margin-bottom:10px;">
                    <i class="fa fa-icons" style="color:#6d67ff;margin-right:8px;"></i>
                    Service Icon
                </label>

                <input
                    type="text"
                    name="Service_icon"
                    placeholder="e.g. fa fa-code"
                    style="box-sizing:border-box;width:100%;height:50px;padding:0 16px;border:1px solid #dfe3ef;border-radius:10px;background:#fafbff;font-size:14px;color:#303650;outline:none;"
                >

                <p style="font-size:12px;color:#9298ac;margin:8px 0 0 0;">
                    Enter the icon class used by your existing portfolio.
                </p>
            </div>

            <!-- Service Description -->
            <div style="margin-bottom:30px;">
                <label style="display:block;font-size:14px;font-weight:700;color:#343b59;margin-bottom:10px;">
                    <i class="fa fa-align-left" style="color:#6d67ff;margin-right:8px;"></i>
                    Service Description
                </label>

                <input
                    type="text"
                    name="Service_discription"
                    placeholder="Describe the service you provide"
                    style="box-sizing:border-box;width:100%;height:50px;padding:0 16px;border:1px solid #dfe3ef;border-radius:10px;background:#fafbff;font-size:14px;color:#303650;outline:none;"
                >

                <p style="font-size:12px;color:#9298ac;margin:8px 0 0 0;">
                    Add a short description of your service.
                </p>
            </div>

            <!-- Footer -->
            <div style="display:flex;justify-content:flex-end;padding-top:23px;border-top:1px solid #edf0f7;">

                <button
                    type="submit"
                    style="border:none;background:linear-gradient(135deg,#6d67ff,#554be8);color:white;padding:14px 30px;border-radius:10px;font-size:14px;font-weight:800;cursor:pointer;box-shadow:0 5px 15px rgba(109,103,255,0.25);"
                >
                    <i class="fa fa-save" style="margin-right:8px;"></i>
                    Save Service
                </button>

            </div>

        </form>
    </div>

</div>

            </div>

 <%-include('footer.ejs'); %>