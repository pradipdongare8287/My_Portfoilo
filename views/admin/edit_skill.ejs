<%-include('header.ejs'); %>

            <!-- ===== DASHBOARD CONTENT ===== -->
            <div class="page-content">
             
<div class="container-fluid" style="padding:30px;background:#f4f6fb;min-height:100vh;">
    <!-- Page Header -->
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;margin-bottom:30px;">
        <div>
            <h1 style="font-size:30px;font-weight:800;color:#252b48;margin:0 0 8px 0;">
                Manage Skill
            </h1>
            <p style="font-size:14px;color:#858ba3;margin:0;">
                Welcome back, <%=username%> Here's your overview
            </p>
        </div>
        <div style="background:#e9e8ff;color:#6259e8;padding:11px 18px;border-radius:30px;font-size:12px;font-weight:800;letter-spacing:1px;">
            <i class="fa fa-code" style="margin-right:7px;"></i>
            SKILL MANAGEMENT
        </div>
    </div>
    <!-- Table Card -->
    <div style="background:white;border-radius:16px;overflow:hidden;box-shadow:0 8px 35px rgba(35,45,90,0.08);">
        <!-- Table Header -->
        <div style="padding:23px 25px;border-bottom:1px solid #edf0f7;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;">
            <div>
                <h2 style="font-size:20px;font-weight:800;color:#252b48;margin:0 0 6px 0;">
                    <i class="fa fa-list-alt" style="color:#6d67ff;margin-right:9px;"></i>
                    Technology Skills
                </h2>
                <p style="font-size:13px;color:#9298ac;margin:0;">
                    View and manage your technology records
                </p>
            </div>
            <div style="background:#f0efff;color:#6259e8;padding:9px 14px;border-radius:9px;font-size:13px;font-weight:700;">
                <i class="fa fa-database" style="margin-right:6px;"></i>
                Skill Records
            </div>
        </div>
        <!-- Responsive Table -->
        <div style="width:100%;overflow-x:auto;">
            <table style="width:100%;min-width:600px;border-collapse:collapse;text-align:left;">
                <thead>
                    <tr style="background:#f7f8fc;color:#555d78;">
                        <th style="padding:17px 22px;font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:0.7px;border-bottom:1px solid #e9ecf4;width:90px;">
                            Sr. No
                        </th>

                        <th style="padding:17px 22px;font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:0.7px;border-bottom:1px solid #e9ecf4;">
                            Technology Name
                        </th>

                        <th style="padding:17px 22px;font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:0.7px;border-bottom:1px solid #e9ecf4;">
                            Technology (%)
                        </th>
                        <th style="padding:17px 22px;font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:0.7px;border-bottom:1px solid #e9ecf4;text-align:center;">
                            Status
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <% for(var i=0;i<skill.length;i++){ %>

                    <tr style="background:white;">

                        <td style="padding:18px 22px;border-bottom:1px solid #f0f1f6;color:#858ba3;font-size:14px;font-weight:700;">
                            <span style="display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:9px;background:#f0efff;color:#6259e8;">
                                <%=i+1%>
                            </span>
                        </td>

                        <td style="padding:18px 22px;border-bottom:1px solid #f0f1f6;color:#303650;font-size:14px;font-weight:700;">
                            <i class="fa fa-code" style="color:#7770ff;margin-right:10px;"></i>
                            <%=skill[i].tecnology%>
                        </td>

                        <td style="padding:18px 22px;border-bottom:1px solid #f0f1f6;">
                            <div style="display:flex;align-items:center;gap:12px;min-width:180px;">
                                <div style="flex:1;height:8px;background:#eceef5;border-radius:20px;overflow:hidden;">
                                    <div style="height:100%;width:<%=skill[i].percentage%>;background:linear-gradient(90deg,#6d67ff,#9b79ff);border-radius:20px;"></div>
                                </div>
                                <span style="font-size:13px;font-weight:800;color:#6259e8;white-space:nowrap;">
                                    <%=skill[i].percentage%>
                                </span>
                            </div>
                        </td>

                        <td style="padding:18px 22px;border-bottom:1px solid #f0f1f6;text-align:center;white-space:nowrap;">

                            <a href="/admin/del_tech/<%=skill[i].tech_id%>" style="text-decoration:none;display:inline-block;margin-right:6px;">
                                <button type="button" class="btn btn-danger" title="Delete Skill"
                                    style="width:38px;height:38px;border:none;border-radius:9px;background:#fff0f0;color:#e34b55;cursor:pointer;">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </a>

                            <a style="text-decoration:none;display:inline-block;">
                                <button type="button" class="btn btn-warning" title="Edit Skill"
                                    style="width:38px;height:38px;border:none;border-radius:9px;background:#fff5df;color:#d99516;cursor:pointer;">
                                    <i class="fa fa-pencil"></i>
                                </button>
                            </a>

                        </td>

                    </tr>

                    <% } %>
                </tbody>

            </table>
        </div>

        <!-- Table Footer -->
        <div style="padding:16px 25px;background:#fcfcfe;border-top:1px solid #edf0f7;">
            <p style="font-size:12px;color:#9298ac;margin:0;">
                <i class="fa fa-info-circle" style="margin-right:6px;color:#6d67ff;"></i>
                Manage your technology skills and proficiency levels here.
            </p>
        </div>

    </div>
</div>

            </div>

 <%-include('footer.ejs'); %>