<%-include('header.ejs')%>


            <!-- ===== DASHBOARD CONTENT ===== -->
            <div class="page-content">
               
<div class="container-fluid" style="padding:30px;background:#f4f6fb;min-height:100vh;">

    <!-- Page Header -->
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;margin-bottom:28px;">
        <div>
            <h1 style="font-size:30px;font-weight:800;color:#252b48;margin:0 0 8px 0;">
                Add Home
            </h1>
            <p style="font-size:14px;color:#858ba3;margin:0;">
                Manage your homepage content and profile details
            </p>
        </div>

        <div style="background:#e9e8ff;color:#6259e8;padding:10px 18px;border-radius:30px;font-size:12px;font-weight:800;letter-spacing:1px;">
            HOME SETTINGS
        </div>
    </div>

    <!-- Main Card -->
    <div style="max-width:1000px;margin:0 auto;background:white;border-radius:18px;overflow:hidden;box-shadow:0 8px 35px rgba(35,45,90,0.08);">

        <!-- Card Header -->
        <div style="background:linear-gradient(135deg,#6d67ff,#8b83ff);padding:28px 30px;color:white;">
            <h2 style="font-size:23px;font-weight:800;margin:0 0 8px 0;">
                Homepage Information
            </h2>
            <p style="font-size:13px;color:#eeedff;margin:0;">
                Update your name, position, description and profile image
            </p>
        </div>

        <!-- Form -->
        <form action="/admin/save_hero/<%=deta.Photo%>" method="post" enctype="multipart/form-data"
              style="padding:30px;">

            <!-- Name and Position -->
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:24px;">

                <div>
                    <label style="display:block;font-size:14px;font-weight:700;color:#343b59;margin-bottom:10px;">
                        Full Name
                    </label>

                    <input type="text" name="name" value="<%=deta.name%>"
                    style="box-sizing:border-box;width:100%;height:48px;padding:0 15px;border:1px solid #dfe3ef;border-radius:10px;background:#fafbff;font-size:14px;color:#303650;outline:none;">
                </div>

                <div>
                    <label style="display:block;font-size:14px;font-weight:700;color:#343b59;margin-bottom:10px;">
                        Position
                    </label>

                    <input type="text" name="Position" value="<%=deta.Position%>"
                    style="box-sizing:border-box;width:100%;height:48px;padding:0 15px;border:1px solid #dfe3ef;border-radius:10px;background:#fafbff;font-size:14px;color:#303650;outline:none;">
                </div>

            </div>

            <!-- Experience Description -->
            <div style="margin-top:25px;">
                <label style="display:block;font-size:14px;font-weight:700;color:#343b59;margin-bottom:10px;">
                    Experience Description
                </label>

                <input type="text" name="experience_disc" value="<%=deta.experience_disc%>"
                style="box-sizing:border-box;width:100%;height:52px;padding:0 15px;border:1px solid #dfe3ef;border-radius:10px;background:#fafbff;font-size:14px;color:#303650;outline:none;">
            </div>

            <!-- Image Section -->
            <div style="margin-top:32px;padding-top:27px;border-top:1px solid #edf0f7;">

                <h3 style="font-size:18px;font-weight:800;color:#252d4b;margin:0 0 20px 0;">
                    Profile Image
                </h3>

                <div style="display:flex;align-items:center;gap:25px;flex-wrap:wrap;">

                    <!-- Old Image -->
                    <div style="min-width:150px;text-align:center;padding:18px;background:#fafbff;border:1px solid #e5e8f2;border-radius:14px;">
                        <img src="/<%=deta.Photo%>"
                             alt="Old profile image"
                             style="width:130px;height:130px;object-fit:cover;border-radius:12px;border:3px solid white;box-shadow:0 4px 15px rgba(0,0,0,0.12);">

                        <p style="font-size:12px;color:#777f98;font-weight:700;margin:12px 0 0 0;">
                            CURRENT IMAGE
                        </p>
                    </div>

                    <!-- Upload New Image -->
                    <div style="flex:1;min-width:220px;">
                        <label style="display:block;font-size:14px;font-weight:700;color:#343b59;margin-bottom:12px;">
                            Upload New Image
                        </label>

                        <div style="padding:25px 20px;border:2px dashed #c9c8ff;border-radius:13px;background:#fafaff;">
                            <input type="file" name="Photo"
                                   style="width:100%;font-size:13px;color:#555;">

                            <p style="font-size:12px;color:#858ba3;margin:13px 0 0 0;">
                                Choose an image from your computer.
                            </p>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Footer / Save Button -->
            <div style="display:flex;justify-content:flex-end;margin-top:35px;padding-top:25px;border-top:1px solid #edf0f7;">

                <button type="submit"
                        style="border:none;background:linear-gradient(135deg,#6d67ff,#554be8);color:white;padding:14px 35px;border-radius:10px;font-size:14px;font-weight:800;cursor:pointer;box-shadow:0 5px 15px rgba(109,103,255,0.25);">
                    Save Changes &#10003;
                </button>

            </div>

        </form>
    </div>
</div>

            </div>
            <!-- Page Header -->
                   

<%-include('footer.ejs')%>
