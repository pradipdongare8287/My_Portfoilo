<%- include('header.ejs')%>

    
            <!-- ===== DASHBOARD CONTENT ===== -->
            <div class="page-content">
             
<div class="container-fluid" style="padding: 20px;">

    <!-- Page Header -->
    <div class="page-header d-flex justify-content-between align-items-center"
         style="padding: 20px 0; margin-bottom: 25px;
                border-bottom: 2px solid #e9ecef;">

        <div>
            <h1 class="h3 mb-1"
                style="font-weight: 700; color: #2c3e50;">
                Manage testimonials
            </h1>

            <p class="text-muted small mb-0">
                Welcome back,<%=username%> Here's your overview
            </p>
        </div>

        <div></div>
    </div>

    <!-- Testimonials Table Card -->
    <div style="background: #ffffff; padding: 20px;
                border-radius: 15px;
                box-shadow: 0 5px 25px rgba(0,0,0,0.08);
                overflow-x: auto;">

        <table border="0" width="100%"
               style="border-collapse: separate; border-spacing: 0;
                      min-width: 750px;">

            <tr style="background: linear-gradient(135deg, #4776E6, #6C5CE7);
                       color: white; text-align: center; font-size: 15px;">

                <th style="padding: 17px 12px; border-radius: 10px 0 0 0;">Sr</th>
                <th style="padding: 17px 12px;">Client Name</th>
                <th style="padding: 17px 12px;">Client Position</th>
                <th style="padding: 17px 12px;">Client Description</th>
                <th style="padding: 17px 12px; border-radius: 0 10px 0 0;">Action</th>

            </tr>

            <% for(var i=0;i<deta.length;i++){ %>

            <tr style="background-color: <%= i % 2 === 0 ? '#f7f8ff' : '#ffffff' %>;
                       font-size: 15px; text-align: center; color: #344054;">

                <td style="padding: 16px 12px; border-bottom: 1px solid #e9ecef;">
                    <%=i+1%>
                </td>

                <td style="padding: 16px 12px; border-bottom: 1px solid #e9ecef;
                           font-weight: 600; color: #2c3e50;">
                    <%=deta[i].clint_name%>
                </td>

                <td style="padding: 16px 12px; border-bottom: 1px solid #e9ecef;">
                    <span style="display: inline-block; padding: 7px 12px;
                                 background: #eeedff; color: #5145cd;
                                 border-radius: 20px; font-size: 13px;
                                 font-weight: 600;">
                        <%=deta[i].client_position%>
                    </span>
                </td>

                <td style="padding: 16px 14px; border-bottom: 1px solid #e9ecef;
                           text-align: left; line-height: 1.6;
                           max-width: 350px; overflow-wrap: anywhere;">
                    <%=deta[i].client_discription%>
                </td>

                <td style="padding: 16px 12px; border-bottom: 1px solid #e9ecef;
                           white-space: nowrap;">

                    <a href="/admin/del_testimonials/<%=deta[i].test_id%>"
                       style="text-decoration: none; margin-right: 6px;">

                        <button class="btn btn-danger"
                                style="border-radius: 8px; padding: 9px 12px;
                                       box-shadow: 0 3px 8px rgba(220,53,69,0.2);">
                            <i class="fa fa-trash"></i>
                        </button>
                    </a>

                    <a>
                        <button class="btn btn-success"
                                style="border-radius: 8px; padding: 9px 12px;
                                       box-shadow: 0 3px 8px rgba(25,135,84,0.2);">
                            <i class="fa fa-pencil"></i>
                        </button>
                    </a>

                </td>

            </tr>

            <% } %>

        </table>
    </div>

</div>

            </div>




<%- include('footer.ejs')%>
