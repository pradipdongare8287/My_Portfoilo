<%-include('header.ejs')%>
   <!-- ===== DASHBOARD CONTENT ===== -->
            <div class="page-content">
               
<div class="container-fluid" style="padding: 20px;">

    <!-- Page Header -->
    <div class="page-header d-flex justify-content-between align-items-center"
         style="padding: 20px 0; margin-bottom: 25px;
                border-bottom: 2px solid #e9ecef;">

        <div>
            <h1 class="h3 mb-1"
                style="font-weight: 700; color: #2c3e50;">
                Add Testimonial
            </h1>

            <p class="text-muted small mb-0">
                Welcome back,<%=username%> Here's your overview
            </p>
        </div>

        <div></div>
    </div>

    <!-- Testimonial Form Card -->
    <div style="max-width: 650px; width: 100%; box-sizing: border-box;
                margin: 25px auto; padding: 30px;
                background: #ffffff; border-radius: 18px;
                box-shadow: 0 8px 30px rgba(0,0,0,0.08);
                border: 1px solid #edf0f5;">

        <div style="text-align: center; margin-bottom: 28px;">
            <div style="height: 65px; width: 65px; margin: 0 auto 15px;
                        display: flex; align-items: center;
                        justify-content: center; border-radius: 50%;
                        background: linear-gradient(135deg, #e9e7ff, #d8d4ff);
                        color: #5145cd; font-size: 27px;">
                <i class="fa fa-comments"></i>
            </div>

            <h4 style="color: #5145cd; font-weight: 700; margin-bottom: 8px;">
                Client Testimonial
            </h4>

            <p style="color: #8892a0; font-size: 14px; margin: 0;">
                Add your client's feedback and details
            </p>
        </div>

        <form action="/admin/add_client" method="post">

            <label style="display: block; font-size: 15px;
                          color: #344054; font-weight: 600;
                          margin-bottom: 8px;">
                <i class="fa fa-user" style="color: #6d67ff;"></i>
                Client Name
            </label>

            <input type="text" name="clint_name"
                   style="display: block; width: 100%; height: 46px;
                          box-sizing: border-box; padding: 0 14px;
                          border: 1px solid #d5dbea; border-radius: 9px;
                          background: #fafbff; font-size: 15px;
                          margin-bottom: 22px;"/>

            <label style="display: block; font-size: 15px;
                          color: #344054; font-weight: 600;
                          margin-bottom: 8px;">
                <i class="fa fa-briefcase" style="color: #6d67ff;"></i>
                Client Position
            </label>

            <input type="text" name="client_position"
                   style="display: block; width: 100%; height: 46px;
                          box-sizing: border-box; padding: 0 14px;
                          border: 1px solid #d5dbea; border-radius: 9px;
                          background: #fafbff; font-size: 15px;
                          margin-bottom: 22px;"/>

            <label style="display: block; font-size: 15px;
                          color: #344054; font-weight: 600;
                          margin-bottom: 8px;">
                <i class="fa fa-commenting" style="color: #6d67ff;"></i>
                Client Discription
            </label>

            <textarea name="client_discription"
                      style="display: block; width: 100%; height: 140px;
                             box-sizing: border-box; padding: 13px 14px;
                             border: 1px solid #d5dbea; border-radius: 9px;
                             background: #fafbff; font-size: 15px;
                             resize: vertical; margin-bottom: 25px;"></textarea>

            <button type="submit"
                    style="display: block; width: 100%; height: 47px;
                           background: linear-gradient(135deg, #6d67ff, #5145cd);
                           color: white; border: none; border-radius: 10px;
                           font-size: 16px; font-weight: 600;
                           cursor: pointer;
                           box-shadow: 0 5px 12px rgba(109,103,255,0.25);">
                <i class="fa fa-save"></i> Save Testimonial
            </button>

        </form>
    </div>

</div>

            </div>
<%-include('footer.ejs')%>
