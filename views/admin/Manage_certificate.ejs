<%-include("header.ejs");%>



        <div style="width: 100%; overflow-x: auto; margin-top: 20px;">

    <table style="
        width: 100%;
        border-collapse: collapse;
        font-family: Arial, sans-serif;
        background: #ffffff;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        border-radius: 10px;
        overflow: hidden;
    ">

         <!-- Table Header -->
        <thead>
            <tr style="background: #1e293b; color: #ffffff;">

                <th style="
                    padding: 15px;
                    border: 1px solid #e2e8f0;
                    text-align: center;
                ">Sr.No</th>

                <th style="
                    padding: 15px;
                    border: 1px solid #e2e8f0;
                    text-align: center;
                ">Certificate Image</th>

                <th style="
                    padding: 15px;
                    border: 1px solid #e2e8f0;
                    text-align: center;
                ">Certificate Name</th>

                <th style="
                    padding: 15px;
                    border: 1px solid #e2e8f0;
                    text-align: center;
                ">Certificate Institute</th>

                <th style="
                    padding: 15px;
                    border: 1px solid #e2e8f0;
                    text-align: center;
                ">Action</th>

            </tr>
        </thead>

         
        <tbody>

            <% for(var i=0;i<certificate.length;i++){ %>

            <tr style="
                background: #ffffff;
                transition: 0.3s;
            ">

                <!-- Sr No -->
                <td style="
                    padding: 12px;
                    border: 1px solid #e2e8f0;
                    text-align: center;
                    font-weight: 600;
                    color: #334155;
                ">
                    <%=i+1%>
                </td>

                <!-- Certificate Image -->
                <td style="
                    padding: 10px;
                    border: 1px solid #e2e8f0;
                    text-align: center;
                ">
                    <img 
                        src="/<%=certificate[i].certificate_img%>"
                        alt="Certificate"
                        style="
                            width: 100px;
                            height: 70px;
                            object-fit: cover;
                            border-radius: 6px;
                            border: 1px solid #cbd5e1;
                        "
                    >
                </td>

                <!-- Certificate Name -->
                <td style="
                    padding: 12px;
                    border: 1px solid #e2e8f0;
                    text-align: center;
                    color: #334155;
                ">
                   <%=certificate[i].certificate_name%>
                    
                </td>

                <!-- Institute -->
                <td style="
                    padding: 12px;
                    border: 1px solid #e2e8f0;
                    text-align: center;
                    color: #334155;
                ">
                   <%=certificate[i].certificate_decleare_institude%>
                </td>

                <!-- Action -->
                <td style="
                    padding: 12px;
                    border: 1px solid #e2e8f0;
                    text-align: center;
                ">

                    
                    <a href="/admin/delete_certificate/<%=certificate[i].cid%>"
                       onclick="return confirm('Are you sure you want to delete <%=certificate[i].certificate_name%> certificate?')"
                       style="
                           display: inline-block;
                           padding: 8px 14px;
                           background: #dc2626;
                           color: #ffffff;
                           text-decoration: none;
                           border-radius: 5px;
                           font-size: 14px;
                       ">
                        Delete
                    </a>

                </td>

            </tr>

            <% } %>

           

        </tbody>

    </table>

</div> 






   