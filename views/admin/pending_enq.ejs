<%-include('header.ejs'); %>
    
            <!-- ===== DASHBOARD CONTENT ===== -->
            <div class="page-content">
                <div class="container-fluid">
                    <!-- Page Header -->
                    <div class="page-header d-flex justify-content-between align-items-center">
                        <div>
                            <h1 class="h3 mb-1">Pending Request</h1>
                            <p class="text-muted small mb-0">Welcome back, Here's your overview</p>
                        </div>
                        <div>
                           
                        </div>
                    </div>

                    <!-- Stat Cards -->
                     <div>
   <table style="width:100%; border-collapse:collapse; font-family:Arial,sans-serif; background:#fff; box-shadow:0px 4px 12px rgba(0,0,0,0.2); border-radius:8px; overflow:hidden;">

       <tr style="background:#0d6efd; color:white; height:55px;">

                <th style="padding:12px; border:1px solid #ddd;">Sr.No</th>
                <th style="padding:12px; border:1px solid #ddd;">Name</th>
                <th style="padding:12px; border:1px solid #ddd;">Email</th>
                <th style="padding:12px; border:1px solid #ddd;">Subject</th>
                <th style="padding:12px; border:1px solid #ddd;">Message</th>
                <th style="padding:12px; border:1px solid #ddd;">Date</th>
                <th style="padding:12px; border:1px solid #ddd;">Status</th>

        </tr>

    <% for(var i=0;i<penditreq.length;i++){ %>

    <tr style="height:60px; text-align:center; background:<%= i%2==0 ? '#ffffff' : '#f8f9fa' %>;">

        <td style="padding:12px; border:1px solid #ddd;"><%=i+1%></td>
        <td style="padding:12px; border:1px solid #ddd;"> <%=penditreq[i].name%> </td>
        <td style="padding:12px; border:1px solid #ddd;"><%=penditreq[i].email%></td>
        <td style="padding:12px; border:1px solid #ddd;"><%=penditreq[i].subject%></td>
        <td style="padding:12px; border:1px solid #ddd; max-width:250px; word-wrap:break-word;"><%=penditreq[i].message%></td>
        <td style="padding:12px; border:1px solid #ddd;"><%=penditreq[i].cdate%></td>
        <td style="padding:12px; border:1px solid #ddd;">
        <a href="/admin/confirm_request/<%=penditreq[i].cid%>" style="text-decoration:none;">
        <button style="background:#dc3545; color:white; border:none; padding:8px 18px; border-radius:5px; cursor:pointer; font-weight:bold; margin-right:8px;">Confirm</button>
        </a>
        <a href="/admin/reject_req/<%=penditreq[i].cid%>" style="text-decoration:none;">
        <button style="background:#198754; color:white; border:none; padding:8px 18px; border-radius:5px; cursor:pointer; font-weight:bold;">Reject</button>
        </a>
        </td>
    </tr>

    <% } %>

</table>
                     </div>
                    
                </div>
            </div>

 <%-include('footer.ejs'); %>