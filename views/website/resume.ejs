<%-include('header.ejs');%>
  <section id="resume" class="resume">
        <div class="container">
            <div class="section-header">
                <span class="section-tag">Resume</span>
                <h2 class="section-title">My Skills &amp; Expertise</h2>
                <p class="section-desc">A snapshot of my technical capabilities and professional experience</p>
            </div>
            
            <div class="resume-grid">
                <!-- Technical Skills -->
                <div class="skills-container">
                    <h3>Technical Skills</h3>
                    
                    <% for(var i=0;i<skill.length;i++){ %>

                    <div class="skill-item">
                        <div class="skill-header">
                            <span class="skill-name"><%=skill[i].tecnology%></span>
                            <span class="skill-percent"><%=skill[i].percentage%> %</span>
                        </div>
                        <div class="progress-bar">
                            <div class="progress-fill" data-width="95"></div>
                        </div>
                    </div>
                    
                    <% } %>
                   
                </div>
                
                <!-- Experience Timeline -->
                <div class="timeline-container">
                    <h3>Experience</h3>
                    
                    <% for(var a=0;a<data.length;a++){ %>

                    <div class="timeline">
                        <div class="timeline-item">
                            <div class="timeline-dot"></div>
                            <div class="timeline-content">
                                <span class="timeline-date"><%=data[a].experience_year %></span>
                                <h4><%=data[a].Position %></h4>
                                <p class="timeline-company"><%=data[a].experience_company %></p>
                                <p><%=data[a].experience_disc %></p>
                            </div>
                        </div>
                    </div>   
                        <% } %>
                    <!-- ----- --> 
                    <h3 style="margin-top: 70px;">Education</h3>
                    <% for(var b=0;b<education.length;b++){ %>
                    <div class="timeline">
                        <div class="timeline-item">
                            <div class="timeline-dot"></div>
                            <div class="timeline-content">
                                <span class="timeline-date"><%=education[b].Eduction_year%></span>
                                <h4><%=education[b].Qualification%></h4>
                                <p class="timeline-company"><%=education[b].University%></p>
                            </div>
                        </div>
                        
                    </div>
                    <% } %>
                    <!-- ----- -->
                </div> 
            </div>
        </div>
    </section>
<%-include('footer.ejs');%>
